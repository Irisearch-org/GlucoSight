    {
      "id": "el29",
      "type": "text",
      "x": 55,
      "y": 1105,
      "width": 685,
      "height": 152,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
